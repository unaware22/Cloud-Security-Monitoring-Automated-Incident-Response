# AWS EC2 + Amazon RDS deployment. Copy to .env on the EC2 host only.
NODE_ENV=production
APP_BASE_URL=http://EC2_PUBLIC_IPV4
DATABASE_URL=postgresql://RDS_MASTER_USERNAME:REPLACE_WITH_RDS_PASSWORD@RDS_ENDPOINT:5432/ecommerce_db?schema=public&sslmode=require

# Generate independent values with: openssl rand -hex 32
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
SECURITY_EVENT_RELAY_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_32_BYTE_SECRET

# Keep Sandbox values for thesis testing. The public client key is baked in
# during docker compose build, while the server key stays runtime-only.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=REPLACE_ME_WITH_FULL_SANDBOX_SERVER_KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=REPLACE_ME_WITH_FULL_SANDBOX_CLIENT_KEY

# Cloudflare Turnstile bot protection for the public checkout page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_ME_WITH_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=saladinshop.duckdns.org

# SMTP configuration for order-delivery email.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=SALADINSHOP <no-reply@example.com>

# Used once to initialize the empty RDS database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

LOG_DIR=/app/logs
