generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String?
  price           Int
  stock           Int         @default(0)
  sortOrder       Int         @default(0) @map("sort_order")
  productType     String      @default("digital") @map("product_type")
  deliveryContent String?     @map("delivery_content")
  imageUrl        String?     @map("image_url")
  game            String      @default("minecraft") // 'minecraft' | 'roblox'
  subCategory1    String      @default("all") @map("sub_category_1")
  subCategory2    String?     @map("sub_category_2")
  deliveryType    String      @default("automatic") @map("delivery_type") // 'automatic' | 'manual'
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  orderItems      OrderItem[]

  @@map("products")
}

model Order {
  id                       String                     @id @default(uuid())
  orderCode                String                     @unique @map("order_code")
  customerName             String                     @map("customer_name")
  customerEmail            String                     @map("customer_email")
  customerPhone            String?                    @map("customer_phone")
  totalAmount              Int                        @map("total_amount")
  orderStatus              String                     @default("created") @map("order_status") // created, waiting_payment, processing, completed, cancelled, expired
  paymentStatus            String                     @default("pending") @map("payment_status") // pending, pending_manual, paid, paid_manual, failed, expired, rejected
  deliveryStatus           String                     @default("pending") @map("delivery_status") // pending, processing, delivered, failed, resent
  paymentMethod            String                     @map("payment_method") // xendit_invoice, manual_transfer, manual_qris
  expiredAt                DateTime?                  @map("expired_at")
  paidAt                   DateTime?                  @map("paid_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  orderItems               OrderItem[]
  paymentTransactions      PaymentTransaction[]
  manualPaymentSubmissions ManualPaymentSubmission[]
  digitalDeliveries        DigitalDelivery[]

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String   @map("order_id")
  productId           String   @map("product_id")
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Int      @default(1)
  priceSnapshot       Int      @map("price_snapshot")
  subtotal            Int
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  provider          String   // xendit / manual
  providerInvoiceId String?  @map("provider_invoice_id")
  providerPaymentId String?  @map("provider_payment_id")
  paymentUrl        String?  @map("payment_url")
  amount            Int
  status            String   // pending, paid, expired, failed
  rawPayload        String?  @map("raw_payload")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model ManualPaymentSubmission {
  id           String     @id @default(uuid())
  orderId      String     @map("order_id")
  senderName   String     @map("sender_name")
  senderBank   String     @map("sender_bank")
  amount       Int
  transferTime DateTime?  @map("transfer_time")
  note         String?
  proofUrl     String?    @map("proof_url")
  status       String     @default("submitted") @map("status") // submitted, approved, rejected
  reviewedBy   String?    @map("reviewed_by")
  reviewedAt   DateTime?  @map("reviewed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer     AdminUser? @relation(fields: [reviewedBy], references: [id])

  @@map("manual_payment_submissions")
}

model DigitalDelivery {
  id             String    @id @default(uuid())
  orderId        String    @map("order_id")
  deliveryEmail  String    @map("delivery_email")
  deliveryStatus String    @map("delivery_status") // pending, delivered, failed, resent
  deliveryData   String?   @map("delivery_data")
  deliveredAt    DateTime? @map("delivered_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("digital_deliveries")
}

model AdminUser {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  passwordHash            String                    @map("password_hash")
  role                    String                    @default("admin")
  isActive                Boolean                   @default(true) @map("is_active")
  lastLoginAt             DateTime?                 @map("last_login_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  auditLogs               AuditLog[]
  reviewedManualPayments  ManualPaymentSubmission[]

  @@map("admin_users")
}

model AuditLog {
  id         String     @id @default(uuid())
  adminId    String?    @map("admin_id")
  action     String
  entityType String?    @map("entity_type")
  entityId   String?    @map("entity_id")
  oldValue   String?    @map("old_value")
  newValue   String?    @map("new_value")
  ipAddress  String?    @map("ip_address")
  userAgent  String?    @map("user_agent")
  createdAt  DateTime   @default(now()) @map("created_at")
  admin      AdminUser? @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model SecurityEvent {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  severity       String   // low, medium, high, critical
  ipAddress      String   @map("ip_address")
  method         String
  endpoint       String
  userAgent      String?  @map("user_agent")
  payloadSnippet String?  @map("payload_snippet")
  statusCode     Int      @map("status_code")
  description    String?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("security_events")
}
