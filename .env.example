# Application and database
NODE_ENV=production
APP_BASE_URL=https://store.example.com
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/ecommerce_security_thesis?schema=public
POSTGRES_PASSWORD=REPLACE_WITH_THE_SAME_STRONG_DATABASE_PASSWORD

# Generate unique random values of at least 32 characters. Never commit .env.
ADMIN_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SECURITY_EVENT_RELAY_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Midtrans Sandbox for homelab/staging. Change both values only after final production checks.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=NexusVault <no-reply@example.com>

# Required only while initializing the database; remove after the first seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Container-friendly log location monitored by the Wazuh agent.
LOG_DIR=/app/logs
