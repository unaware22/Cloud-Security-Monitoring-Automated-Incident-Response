# Application and database
NODE_ENV=production
APP_BASE_URL=https://store.example.com
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/ecommerce_security_thesis?schema=public
POSTGRES_PASSWORD=REPLACE_WITH_THE_SAME_STRONG_DATABASE_PASSWORD

# Generate unique random values of at least 32 characters. Never commit .env.
ADMIN_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_SESSION_TTL_SECONDS=3600
CUSTOMER_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CUSTOMER_SESSION_TTL_SECONDS=604800
SECURITY_EVENT_RELAY_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Google Identity Services. The OAuth client ID is public, but it must match
# the audience verified by the backend. Never use a Google client secret here.
GOOGLE_CLIENT_ID=REPLACE_ME_WITH_GOOGLE_OAUTH_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_ME_WITH_THE_SAME_GOOGLE_OAUTH_CLIENT_ID

# Private n8n IP-control workflow. These values are server-side only; never
# prefix them with NEXT_PUBLIC_. The token must match the n8n Header Auth value.
N8N_IP_CONTROL_WEBHOOK_URL=https://homelab-n8n.example.ts.net/webhook/saladinshop-ip-control
N8N_IP_CONTROL_WEBHOOK_TOKEN=REPLACE_WITH_A_RANDOM_N8N_CONTROL_TOKEN_OF_AT_LEAST_32_CHARACTERS

# Authenticates n8n callbacks that synchronize automatic/manual response state.
SECURITY_AUTOMATION_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Midtrans Sandbox for homelab/staging. Change both values only after final production checks.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=REPLACE_ME_WITH_FULL_SANDBOX_SERVER_KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=REPLACE_ME_WITH_FULL_SANDBOX_CLIENT_KEY

# Cloudflare Turnstile. Copy the complete keys exactly as shown in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_ME_WITH_TURNSTILE_SECRET_KEY
# Comma-separated hostnames only (no scheme, port, or path). The legacy
# TURNSTILE_EXPECTED_HOSTNAME variable remains supported during migration.
TURNSTILE_EXPECTED_HOSTNAMES=store.example.com,store-admin.example.ts.net

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=NexusVault <no-reply@example.com>

# Required only while initializing the database; remove after the first seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Container-friendly log location monitored by the Wazuh agent.
LOG_DIR=/app/logs
