# Database Configuration (PostgreSQL / Amazon RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_security_thesis?schema=public"

# App Base URL
APP_BASE_URL="http://localhost:3000"

# Admin Authentication
ADMIN_JWT_SECRET="super-secure-admin-jwt-secret-key-thesis-2026-replace-in-production"

# Xendit Payment Gateway (Sandbox / Production)
XENDIT_SECRET_KEY="xnd_development_sample_key_for_mock_and_testing"
XENDIT_WEBHOOK_TOKEN="xendit_webhook_verification_token_sample"

# Email Configuration (Nodemailer / Resend compatible)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_username_placeholder"
SMTP_PASS="smtp_password_placeholder"
SMTP_FROM="noreply@gamestore.local"

# Security & Logging
LOG_LEVEL="info"
LOG_DIR="./logs"
