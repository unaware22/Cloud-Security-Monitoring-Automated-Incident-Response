# CasaOS / homelab staging overrides. Copy to .env.homelab and replace every
# placeholder before deployment. Keep this file and .env.homelab private.
NODE_ENV=production
APP_BASE_URL=http://192.168.1.50:3000

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://app_user:replace-with-the-same-database-password@postgres:5432/ecommerce_security_thesis?schema=public

ADMIN_JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
SECURITY_EVENT_RELAY_TOKEN=replace-with-a-random-string-at-least-32-characters-long
SEED_ADMIN_EMAIL=admin@homelab.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password-at-least-12-characters-long

LOG_DIR=/app/logs
